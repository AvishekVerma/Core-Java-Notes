+"""Tests for the :class:`ConditionNode` class."""
+
+import pytest
+
+from domain_parser.ast_nodes import ConditionNode
+from domain_parser.exceptions import (
+    DomainSyntaxError,
+    InvalidIdentifierError,
+    InvalidOperatorError,
+    UnsupportedComparisonOperator,
+)
+
+
+def test_condition_node_basic_comparison() -> None:
+    """Simple equality comparison should render correctly."""
+
+    node = ConditionNode("name", "=", "Alice")
+    assert node.to_sql() == "name = 'Alice'"
+
+
+def test_condition_node_not_equal() -> None:
+    """The ``!=`` operator should translate to ``<>``."""
+
+    node = ConditionNode("name", "!=", "Bob")
+    assert node.to_sql() == "name <> 'Bob'"
+
+
+def test_condition_node_null_comparisons() -> None:
+    """``None`` values should translate to ``IS NULL`` checks."""
+
+    null_node = ConditionNode("deleted_at", "=", None)
+    assert null_node.to_sql() == "deleted_at IS NULL"
+    not_null_node = ConditionNode("deleted_at", "!=", None)
+    assert not_null_node.to_sql() == "deleted_at IS NOT NULL"
+
+
+def test_condition_node_null_with_invalid_operator() -> None:
+    """Comparing ``None`` with non-equality operators should error."""
+
+    node = ConditionNode("deleted_at", ">", None)
+    with pytest.raises(DomainSyntaxError):
+        node.to_sql()
+
+
+def test_invalid_field_name_raises() -> None:
+    """Field names must be non-empty strings."""
+
+    with pytest.raises(InvalidIdentifierError):
+        ConditionNode("", "=", 1)
+
+
+def test_invalid_operator_raises() -> None:
+    """Operators must be non-empty and supported."""
+
+    with pytest.raises(InvalidOperatorError):
+        ConditionNode("age", "", 1)
+    with pytest.raises(UnsupportedComparisonOperator):
+        ConditionNode("age", "like", 1)

