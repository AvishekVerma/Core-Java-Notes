 """AST node definitions for domain-to-SQL translation."""
 
 from abc import ABC, abstractmethod
 from dataclasses import dataclass, field
 from typing import Any, List
 
+from .exceptions import (
+    ArityError,
+    DomainSyntaxError,
+    InvalidIdentifierError,
+    InvalidOperatorError,
+    RelationFieldError,
+    UnsupportedComparisonOperator,
+)
+from .sql_utils import format_sql_literal, quote_identifier
+
+
+# Set of comparison operators allowed in condition nodes.
+_COMPARISON_OPERATORS = {"=", "!=", "<", "<=", ">", ">="}
+
 
 class BaseNode(ABC):
     """Abstract base class for all AST nodes."""
 
     @abstractmethod
     def to_sql(self) -> str:
         """Return the SQL fragment for this node."""
         raise NotImplementedError
 
 
 @dataclass
 class ConditionNode(BaseNode):
     """Represents a single field comparison.
 
     Attributes:
         field_name: Name of the field being compared.
         operator: Comparison operator as a string.
         value: Literal value for the comparison.
     """
 
     field_name: str
     operator: str
     value: Any
 
+    def __post_init__(self) -> None:
+        """Validate provided field name and operator."""
+
+        if not isinstance(self.field_name, str) or not self.field_name:
+            raise InvalidIdentifierError(
+                f"Field name must be a non-empty string, got {self.field_name!r}"
+            )
+        if "." in self.field_name:
+            raise RelationFieldError(
+                f"Relation field {self.field_name!r} is not supported"
+            )
+
+        if not isinstance(self.operator, str) or not self.operator:
+            raise InvalidOperatorError(
+                f"Invalid operator {self.operator!r} for field {self.field_name!r}"
+            )
+        if self.operator not in _COMPARISON_OPERATORS:
+            raise UnsupportedComparisonOperator(
+                f"Unsupported comparison operator {self.operator!r}"
+            )
+
+    @classmethod
+    def from_token(cls, condition_token: Any, position: int) -> "ConditionNode":
+        """Create a condition node from a raw domain token.
+
+        Args:
+            condition_token: The ``(field, operator, value)`` triple.
+            position: Index of the token in the domain expression.
+
+        Raises:
+            ArityError: If the token does not contain exactly three elements.
+
+        Returns:
+            A validated :class:`ConditionNode` instance.
+        """
+
+        if not (isinstance(condition_token, (list, tuple)) and len(condition_token) == 3):
+            raise ArityError(
+                "Invalid domain element at position "
+                f"{position}: expected 3-tuple, got {condition_token!r}"
+            )
+        field_name, operator_symbol, comparison_value = condition_token  # type: ignore[misc]
+        return cls(field_name, operator_symbol, comparison_value)
+
     def to_sql(self) -> str:
         """Render the condition into an SQL expression."""
-        raise NotImplementedError
+
+        # Quote the field name so it is safe for SQL output.
+        quoted_field = quote_identifier(self.field_name)
+
+        sql_operator = "<>" if self.operator == "!=" else self.operator
+
+        if self.value is None:
+            if sql_operator == "=":
+                return f"{quoted_field} IS NULL"
+            if sql_operator == "<>":
+                return f"{quoted_field} IS NOT NULL"
+            raise DomainSyntaxError(
+                f"Operator {self.operator!r} cannot be used with NULL"
+            )
+
+        literal = format_sql_literal(self.value)
+        return f"{quoted_field} {sql_operator} {literal}"
 
 
 @dataclass
 class AndNode(BaseNode):
     """Represents a logical ``AND`` of child nodes.
 
     Attributes:
         children: Nodes that will be combined with ``AND``.
     """
 
     children: List[BaseNode] = field(default_factory=list)
 
     def to_sql(self) -> str:
         """Combine child nodes using ``AND``."""
         raise NotImplementedError
 
 
 @dataclass
 class OrNode(BaseNode):
     """Represents a logical ``OR`` of child nodes.
 
     Attributes:
         children: Nodes that will be combined with ``OR``.
     """
 
