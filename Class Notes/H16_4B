+import pytest
+
+from domain_parser.ast_nodes import ConditionNode
+from domain_parser.exceptions import (
+    DomainSyntaxError,
+    InvalidIdentifierError,
+)
+
+
+def test_condition_node_renders_equality():
+    node = ConditionNode("name", "=", "Alice")
+    assert node.to_sql() == "name = 'Alice'"
+
+
+def test_condition_node_renders_not_equal():
+    node = ConditionNode("age", "!=", 30)
+    assert node.to_sql() == "age <> 30"
+
+
+def test_condition_node_handles_null_is_null():
+    node = ConditionNode("deleted_at", "=", None)
+    assert node.to_sql() == "deleted_at IS NULL"
+
+
+def test_condition_node_handles_null_is_not_null():
+    node = ConditionNode("deleted_at", "!=", None)
+    assert node.to_sql() == "deleted_at IS NOT NULL"
+
+
+def test_condition_node_rejects_null_with_invalid_operator():
+    node = ConditionNode("age", ">", None)
+    with pytest.raises(DomainSyntaxError):
+        node.to_sql()
+
+
+def test_condition_node_validates_field_name():
